# --- Web server (Docker only; `next dev` uses 3000 unless you pass -p) ---
# WEB_PORT is the HOST port the container is published on.
# APP_PORT is the port inside the container. Both default to 3000.
# Neither changes NEXTAUTH_URL/APP_BASE_URL, which must be your PUBLIC url.
WEB_PORT=3000
APP_PORT=3000

# Copy this file to .env.local for local development.
# Do NOT commit a real .env file with secrets.

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000
# Not needed for local `next dev` (localhost is trusted automatically), but
# required in production (see docker-compose.yml) — Auth.js otherwise refuses
# requests from a host it doesn't already recognize as safe.
AUTH_TRUST_HOST=true

# Base URL used to build links inside emails (verification links, etc.)
APP_BASE_URL=http://localhost:3000

# --- Database ---
# Path to the SQLite database file. The containing directory is created
# automatically if it doesn't exist.
DATABASE_PATH=./data/app.db

# --- SMTP (for sending verification emails) ---
# Example values for Gmail (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="Pickl <yourname@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pickl <no-reply@example.com>"
