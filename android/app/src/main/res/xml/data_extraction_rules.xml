<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device: not to a cloud backup, and not in a phone-to-phone
  transfer. For apps targeting Android 12 or later, allowBackup="false" stops
  only the cloud backup; a device transfer ignores it and reads these rules
  instead. Without them, the WebView's session cookie would move to the new
  phone along with everything else.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
